MIMIC_CSV_DIR=/absolute/path/to/mimic-csv
MEDDIAL_COHORT_REVIEWS=/absolute/private/path/cohort_reviews.json

# Default for MIMIC and any derived SCR/dialogue: a self-hosted endpoint inside
# the approved research environment.
MEDDIAL_LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
MEDDIAL_LOCAL_LLM_MODEL=gpt-oss-20b
MEDDIAL_LOCAL_LLM_API_KEY=

# Store the release-manifest salt in the environment, never in Git.
MEDDIAL_PUBLICATION_SALT=replace-with-at-least-16-private-random-characters

# Azure is retained only for public/synthetic inputs after an explicit caller
# selects DataClassification.PUBLIC_OR_SYNTHETIC.
AZURE_AI_ENDPOINT=https://your-endpoint.example
AZURE_AI_API_KEY=replace-me
